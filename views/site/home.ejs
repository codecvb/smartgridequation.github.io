<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="kicker">PERSONAL NOTES</p>
      <h1><%= site.siteTitle %></h1>
      <p class="lede"><%= site.siteSubtitle %></p>
      <form class="search-form" action="<%= staticSite ? 'search.html' : '/search' %>" method="get" role="search">
        <input name="q" type="search" placeholder="搜索文章…" aria-label="搜索文章">
        <button type="submit">搜索</button>
      </form>
    </div>
    <dl class="stat-list">
      <div><dt>文章</dt><dd><%= stats.posts %></dd></div>
      <div><dt>分类</dt><dd><%= stats.categories %></dd></div>
      <div><dt>阅读</dt><dd><%= stats.views %></dd></div>
    </dl>
  </div>
</section>

<section class="wrap section categories-section">
  <div class="section-head">
    <div>
      <p class="eyebrow">COLLECTIONS</p>
      <h2>分类目录</h2>
    </div>
    <a class="text-link" href="/categories">查看全部</a>
  </div>
  <div class="category-grid">
    <% (categories || []).forEach(function(cat, i) { %>
      <a class="category-card" href="/category/<%= cat.slug %>" style="--card-index: <%= i %>">
        <span class="category-num"><%= String(i + 1).padStart(2, '0') %></span>
        <span class="category-name"><%= cat.name %></span>
        <span class="category-count"><%= cat.count %> 篇</span>
        <span class="category-arrow" aria-hidden="true">→</span>
      </a>
    <% }) %>
  </div>
</section>

<section class="wrap section recent-section">
  <div class="section-head">
    <div>
      <p class="eyebrow">RECENT</p>
      <h2>近期文章</h2>
    </div>
    <a class="text-link" href="/archive">全部归档</a>
  </div>
  <div class="recent-list">
    <% posts.forEach(function(post, i) { %>
      <article class="recent-item">
        <span class="recent-index"><%= String(i + 1).padStart(2, '0') %></span>
        <div class="recent-main">
          <h3 class="recent-title"><a href="/post/<%= post.slug %>"><%= post.title %></a></h3>
          <p class="recent-summary"><%= post.summary || '……' %></p>
        </div>
        <div class="recent-meta">
          <span class="recent-category"><%= post.category || '随笔' %></span>
          <time datetime="<%= post.publishedAt %>"><%= formatDate(post.publishedAt) %></time>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="wrap section tags-section">
  <div class="section-head">
    <div>
      <p class="eyebrow">TAGS</p>
      <h2>标签</h2>
    </div>
    <a class="text-link" href="/tags">全部标签</a>
  </div>
  <div class="tag-cloud">
    <% tags.forEach(function(tag) { %>
      <a class="tag-chip" href="/tags?tag=<%= encodeURIComponent(tag.name) %>"><%= tag.name %><em><%= tag.count %></em></a>
    <% }) %>
  </div>
</section>
