<% if (posts && posts.length) { %>
<section class="wrap list-section">
  <div class="list">
    <% posts.forEach(function(post, i) { %>
      <a class="list-item" href="/post/<%= post.slug %>">
        <span class="list-index"><%= String(i + 1).padStart(2, '0') %></span>
        <span class="list-main">
          <span class="list-title"><%= post.title %></span>
          <span class="list-summary"><%= post.summary || '……' %></span>
          <span class="list-category"><%= post.category || '随笔' %></span>
        </span>
        <span class="list-meta">
          <span class="list-tags"><%= post.tags.join(' / ') %></span>
          <time datetime="<%= post.publishedAt %>"><%= formatDate(post.publishedAt) %></time>
        </span>
      </a>
    <% }) %>
  </div>
</section>
<% } else { %>
<section class="wrap list-section">
  <p class="empty">这里还没有文章。</p>
</section>
<% } %>
