<section class="admin-head editor-head">
  <div>
    <p class="kicker">EDITOR</p>
    <h1><%= post.id ? '编辑文章' : '写文章' %></h1>
  </div>
  <div class="editor-head-actions">
    <span class="save-state" id="save-state"></span>
    <a class="btn-ghost" href="/admin/posts">取消</a>
    <button class="btn-secondary" type="submit" form="post-form" name="action" value="save">保存草稿</button>
    <button class="btn-primary" type="submit" form="post-form" name="action" value="publish"><%= post.id ? '更新发布' : '发布文章' %></button>
  </div>
</section>

<% if (ok) { %><div class="alert alert-success">文章已保存。</div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form id="post-form" method="post" action="<%= post.id ? '/admin/posts/' + post.id : '/admin/posts' %>" class="editor-layout">
  <div class="editor-pane editor-fields">
    <label class="field field-title">
      <span>标题</span>
      <input id="post-title" name="title" required value="<%= post.title %>" placeholder="给文章起个标题">
    </label>
    <div class="field-row">
      <label class="field">
        <span>链接地址</span>
        <input id="post-slug" name="slug" value="<%= post.slug %>" placeholder="自动生成">
      </label>
      <label class="field">
        <span>标签</span>
        <input id="post-tags" name="tags" value="<%= post.tags.join(', ') %>" placeholder="逗号分隔">
      </label>
    </div>
    <label class="field">
      <span>摘要</span>
      <textarea id="post-summary" name="summary" rows="3" placeholder="一句话概括这篇文章"><%= post.summary %></textarea>
    </label>
    <div class="editor-toolbar" data-editor-toolbar aria-label="Markdown 工具栏">
      <button type="button" data-md="bold" title="加粗">B</button>
      <button type="button" data-md="italic" title="斜体">I</button>
      <button type="button" data-md="h2" title="二级标题">H2</button>
      <button type="button" data-md="quote" title="引用">“</button>
      <button type="button" data-md="code" title="行内代码">&lt;&gt;</button>
      <button type="button" data-md="link" title="插入链接">link</button>
      <button type="button" data-md="image" title="上传图片">img</button>
      <button type="button" data-md="list" title="无序列表">•</button>
      <button type="button" data-md="task" title="任务清单">☑</button>
    </div>
    <textarea id="post-content" name="content" class="editor-textarea" placeholder="从这里开始写作…"><%= post.content %></textarea>
    <div class="editor-footer">
      <span id="char-count">0 字</span>
      <span class="muted">编辑内容会保存在本地浏览器</span>
    </div>
    <input type="file" id="image-input" accept="image/*" hidden>
  </div>
  <div class="editor-pane editor-preview">
    <div class="preview-head">
      <span class="preview-dot"></span>
      <span>实时预览</span>
    </div>
    <div id="preview" class="prose preview-box" aria-live="polite"></div>
  </div>
</form>
