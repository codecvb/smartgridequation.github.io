<section class="admin-head">
  <div>
    <p class="kicker">POSTS</p>
    <h1>文章管理</h1>
  </div>
  <a class="btn-primary" href="/admin/posts/new">写新文章</a>
</section>

<% if (deleted) { %><div class="alert alert-success">文章已删除。</div><% } %>

<div class="filter-row">
  <a class="filter-chip <%= filter === 'published' ? 'is-active' : '' %>" href="/admin/posts?filter=published">已发布</a>
  <a class="filter-chip <%= filter === 'draft' ? 'is-active' : '' %>" href="/admin/posts?filter=draft">草稿</a>
  <a class="filter-chip <%= filter === 'all' ? 'is-active' : '' %>" href="/admin/posts?filter=all">全部</a>
</div>

<section class="panel">
  <% if (posts.length) { %>
    <div class="table-wrap">
      <table class="admin-table">
        <thead>
          <tr><th>标题</th><th>状态</th><th>阅读</th><th>更新时间</th><th>操作</th></tr>
        </thead>
        <tbody>
          <% posts.forEach(function(post) { %>
            <tr>
              <td class="cell-title"><a href="/admin/posts/<%= post.id %>/edit"><%= post.title %></a></td>
              <td><span class="status <%= post.status === 'published' ? 'is-published' : 'is-draft' %>"><%= post.status === 'published' ? '已发布' : '草稿' %></span></td>
              <td><%= post.viewCount %></td>
              <td><%= formatDate(post.updatedAt, true) %></td>
              <td class="cell-actions">
                <form method="post" action="/admin/posts/<%= post.id %>/toggle">
                  <button class="link-button" type="submit"><%= post.status === 'published' ? '转草稿' : '发布' %></button>
                </form>
                <form method="post" action="/admin/posts/<%= post.id %>/delete" data-confirm="确定删除《<%= post.title %>》吗？">
                  <button class="link-button danger" type="submit">删除</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="empty">当前分类下没有文章。</p>
  <% } %>
</section>
