<section class="admin-head">
  <div>
    <p class="kicker">DASHBOARD</p>
    <h1>仪表盘</h1>
  </div>
  <a class="btn-primary" href="/admin/posts/new">写新文章</a>
</section>

<div class="stat-grid">
  <div class="stat-card"><p>已发布</p><strong><%= stats.posts %></strong></div>
  <div class="stat-card"><p>草稿</p><strong><%= stats.drafts %></strong></div>
  <div class="stat-card"><p>总阅读</p><strong><%= stats.views %></strong></div>
  <div class="stat-card"><p>标签</p><strong><%= stats.tags %></strong></div>
</div>

<section class="panel">
  <div class="panel-head">
    <h2>最近更新</h2>
    <a class="text-link" href="/admin/posts">全部文章</a>
  </div>
  <% if (recent.length) { %>
    <div class="table-wrap">
      <table class="admin-table">
        <thead>
          <tr><th>标题</th><th>状态</th><th>阅读</th><th>更新时间</th><th></th></tr>
        </thead>
        <tbody>
          <% recent.forEach(function(post) { %>
            <tr>
              <td class="cell-title"><a href="/admin/posts/<%= post.id %>/edit"><%= post.title %></a></td>
              <td><span class="status <%= post.status === 'published' ? 'is-published' : 'is-draft' %>"><%= post.status === 'published' ? '已发布' : '草稿' %></span></td>
              <td><%= post.viewCount %></td>
              <td><%= formatDate(post.updatedAt, true) %></td>
              <td><a class="text-link" href="/post/<%= post.slug %>" target="_blank">查看</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="empty">还没有文章，<a href="/admin/posts/new">写第一篇</a>吧。</p>
  <% } %>
</section>
