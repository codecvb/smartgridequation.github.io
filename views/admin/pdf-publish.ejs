<section class="admin-head">
  <div>
    <p class="kicker">PDF PUBLISH</p>
    <h1>发布 PDF</h1>
  </div>
  <a class="btn-ghost" href="/admin/posts">文章管理</a>
</section>

<% if (ok) { %><div class="alert alert-success">PDF 已发布。</div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<section class="panel">
  <div class="panel-head">
    <h2>选择文件并填写信息</h2>
    <span class="muted">最大 50 MB</span>
  </div>
  <form method="post" action="/admin/pdfs" enctype="multipart/form-data" class="form pdf-publish-form">
    <label class="field">
      <span>PDF 文件</span>
      <input name="pdf" type="file" accept="application/pdf,.pdf" required>
    </label>
    <div class="field-row">
      <label class="field">
        <span>标题</span>
        <input name="title" placeholder="留空则使用文件名">
      </label>
      <label class="field">
        <span>链接地址</span>
        <input name="slug" placeholder="自动生成">
      </label>
    </div>
    <div class="field-row">
      <label class="field">
        <span>分类</span>
        <input name="category" value="资料" placeholder="如：讲义、报告">
      </label>
      <label class="field">
        <span>标签</span>
        <input name="tags" value="PDF" placeholder="逗号分隔">
      </label>
    </div>
    <label class="field">
      <span>摘要</span>
      <textarea name="summary" rows="3" placeholder="一句话说明这份文档"></textarea>
    </label>
    <label class="field">
      <span>文档介绍</span>
      <textarea name="content" rows="5" placeholder="可选，支持 Markdown"></textarea>
    </label>
    <div class="form-actions">
      <button class="btn-secondary" type="submit" name="action" value="draft">保存草稿</button>
      <button class="btn-primary" type="submit" name="action" value="publish">直接发布</button>
    </div>
  </form>
</section>

<section class="panel">
  <div class="panel-head">
    <h2>已上传的 PDF</h2>
    <span class="muted"><%= pdfs.length %> 篇</span>
  </div>
  <% if (pdfs.length) { %>
    <div class="table-wrap">
      <table class="admin-table">
        <thead>
          <tr><th>标题</th><th>状态</th><th>文件</th><th>更新时间</th><th>操作</th></tr>
        </thead>
        <tbody>
          <% pdfs.forEach(function(post) { %>
            <tr>
              <td class="cell-title"><a href="/admin/posts/<%= post.id %>/edit"><%= post.title %></a></td>
              <td><span class="status <%= post.status === 'published' ? 'is-published' : 'is-draft' %>"><%= post.status === 'published' ? '已发布' : '草稿' %></span></td>
              <td><%= post.pdfName %></td>
              <td><%= formatDate(post.updatedAt, true) %></td>
              <td class="cell-actions">
                <a class="text-link" href="/post/<%= post.slug %>" target="_blank">查看</a>
                <a class="text-link" href="<%= post.pdfUrl %>" download="<%= post.pdfName %>">下载</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="empty">还没有 PDF 文档。</p>
  <% } %>
</section>
