<section class="admin-head">
  <div>
    <p class="kicker">SETTINGS</p>
    <h1>站点设置</h1>
  </div>
</section>

<% if (ok) { %><div class="alert alert-success">设置已保存。</div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<section class="panel">
  <div class="panel-head"><h2>基本信息</h2></div>
  <form method="post" action="/admin/settings" class="form form-panel">
    <div class="field-row">
      <label class="field"><span>站点名称</span><input name="siteTitle" value="<%= settings.siteTitle %>" required></label>
      <label class="field"><span>作者</span><input name="author" value="<%= settings.author %>"></label>
    </div>
    <label class="field"><span>副标题</span><input name="siteSubtitle" value="<%= settings.siteSubtitle %>"></label>
    <label class="field"><span>页脚文字</span><input name="footerText" value="<%= settings.footerText %>"></label>
    <label class="field"><span>关于我（支持 Markdown）</span><textarea name="bio" rows="5"><%= settings.bio %></textarea></label>
    <div class="field-row">
      <label class="field"><span>GitHub 链接</span><input name="github" value="<%= settings.github %>" placeholder="https://github.com/you"></label>
      <label class="field"><span>邮箱</span><input name="email" value="<%= settings.email %>" placeholder="you@example.com"></label>
    </div>
    <button class="btn-primary" type="submit">保存设置</button>
  </form>
</section>

<section class="panel">
  <div class="panel-head"><h2>修改密码</h2></div>
  <form method="post" action="/admin/password" class="form form-panel">
    <label class="field"><span>原密码</span><input type="password" name="oldPassword" required autocomplete="current-password"></label>
    <div class="field-row">
      <label class="field"><span>新密码</span><input type="password" name="newPassword" required minlength="8" autocomplete="new-password"></label>
      <label class="field"><span>确认新密码</span><input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password"></label>
    </div>
    <button class="btn-primary" type="submit">更新密码</button>
  </form>
</section>
